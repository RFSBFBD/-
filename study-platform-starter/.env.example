# Frontend-safe public configuration. Values prefixed NEXT_PUBLIC_ are exposed to browsers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth (Google provider enabled in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only database URL. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Optional, if using Supabase for Postgres/pgvector. Keep service role key server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (server-side only)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=study-platform-files
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# Object storage selection: auto | r2 | local (compose default: local)
STORAGE_BACKEND=local
API_PUBLIC_BASE_URL=http://localhost:8000

# Chat generation adapter; keep keys server-side. Any OpenAI-compatible provider
# works (OpenRouter, Google Gemini, Groq). Google Gemini:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_CHAT_MODEL=gemini-flash-latest
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_MODEL=

# Embeddings are a separate configuration from chat generation.
# Google Gemini: EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=

# Audio transcription (optional). "" | "none" | "local" (local runs faster-whisper).
TRANSCRIPTION_PROVIDER=
WHISPER_MODEL=small

# Optional worker queue / cache
REDIS_URL=redis://redis:6379/0

# API-to-API shared secret for local/internal service calls; generate a strong random value.
INTERNAL_API_SECRET=
