APP_ENV=development
APP_NAME=AI Study Platform API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# Supabase Auth (replaces Clerk). Fill from your Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_AUDIENCE=authenticated

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=study-platform-files
R2_ENDPOINT_URL=

# Object storage: auto (R2 when configured, else local) | r2 | local
STORAGE_BACKEND=auto
LOCAL_STORAGE_DIR=.data/storage
API_PUBLIC_BASE_URL=http://localhost:8000
SIGNED_URL_TTL_SECONDS=300
UPLOAD_RATE_LIMIT_PER_MINUTE=30
DUPLICATE_SIMILARITY_THRESHOLD=0.8

# Chat generation. Any OpenAI-compatible provider works (OpenRouter, Google
# Gemini, Groq, ...). Google Gemini example:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_CHAT_MODEL=gemini-flash-latest
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_MODEL=

# Embeddings must be configured independently from the chat model.
# Google Gemini example: EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                        EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=

# AI request behavior and RAG budgeting (character/approx-token based).
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_OUTPUT_TOKENS=900
CHUNK_TARGET_CHARS=800
CHUNK_OVERLAP_CHARS=150

# Audio transcription (optional). "" | "none" | "local" (local runs faster-whisper).
# Install the extra dependency with: pip install faster-whisper
TRANSCRIPTION_PROVIDER=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEFAULT_LANGUAGE=

# Study artifact generation (notes/quizzes/cards/mind-map/...).
ARTIFACT_MAX_OUTPUT_TOKENS=2000
ARTIFACT_MAX_SOURCE_CHARS=16000

INTERNAL_API_SECRET=
MAX_UPLOAD_SIZE_MB=100
